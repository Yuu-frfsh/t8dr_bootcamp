# Azure Speech credentials.
# Used by api/speak.js (free-text bar) and, in phase 4, by scripts/tts.js.
# Copy this file to .env and fill it in. .env is gitignored - the key must never
# reach client code, only the serverless function and local scripts.
#
# On Vercel these are set as Environment Variables in the project settings,
# NOT prefixed with VITE_ (a VITE_ prefix would inline the key into the bundle).

AZURE_KEY=
AZURE_REGION=
